  "verification": {
    "source_archives": {
      "algorithm": "sha256",
      "authority": "crates.io",
      "metadata_url_template": "https://crates.io/api/v1/crates/{crate}/{version}",
      "download_url_template": "https://crates.io/api/v1/crates/{crate}/{version}/download",
      "detached_signatures_available": false,
      "signature_source": null
    },
    "sidecar_artifacts": {
      "algorithm": "sha256",
      "authority": "github-release-assets",
      "release_repository": "https://github.com/endomorphosis/ipfs_kit_py",
      "digest_source": "GitHub release asset digest field, pinned per platform in this record",
      "attestation": {
        "required": true,
        "authority": "github-artifact-attestations",
        "detached_upstream_signatures_available": false,
        "verification_command": [
          "gh",
          "attestation",
          "verify",
          "{artifact}",
          "--repo",
          "endomorphosis/ipfs_kit_py"
        ]
      }
    },
    "fail_closed": true
  },
  "data_formats": {
    "blob_identifier": "lowercase hexadecimal encoding of a 32-byte BLAKE3 digest",
    "blob_hash_algorithm": "BLAKE3-256",
    "blob_hash_bytes": 32,
    "document_model": "iroh-docs signed eventually-consistent key/value entries whose values reference iroh-blobs content",
    "filesystem_mapping": "IPFS Kit versioned directory manifests stored as document values; frozen by IROH-002",
    "persistent_store": "private sidecar implementation detail; no upstream store, Bao, redb, or irpc encoding is part of the Python contract",
    "hash_domain": "Iroh hashes are never represented or labeled as IPFS CIDs",
    "credential_encodings": "opaque; only credential references may cross the backend configuration boundary"
  },
  "licenses": {
    "spdx_expression": "MIT OR Apache-2.0",
    "upstream_notice_files": ["LICENSE-MIT", "LICENSE-APACHE"],
    "redistribution_requirement": "Ship both upstream license texts and IPFS Kit license/notice material with every sidecar archive."
  },
  "breaking_boundaries": [
    {
      "boundary": "iroh < 1.0",
      "effect": "pre-1.0 endpoint, relay, key, and transport APIs are outside the stable 1.x contract",
      "action": "reject at startup; migration requires a new audited bundle and conformance run"
    },
    {
      "boundary": "iroh-blobs < 0.103",
      "effect": "not the release line updated for iroh 1.0; RPC and store APIs are version-sensitive",
      "action": "reject at build and runtime version handshake"
    },
    {
      "boundary": "iroh-docs < 0.101",
      "effect": "older releases use pre-1.0 Iroh dependencies and older redb migration behavior",
      "action": "open a copy of the data directory with the pinned release before any in-place upgrade"
    },
    {
      "boundary": "any component version outside this exact bundle",
      "effect": "minor releases of protocol crates may contain breaking API or wire/storage changes",
      "action": "fail closed; do not rely on Cargo semver resolution or CLI output compatibility"
    },
    {
      "boundary": "sidecar RPC protocol != 1",
      "effect": "request, response, capability, or error semantics may differ",
      "action": "refuse the connection before issuing storage operations"
    }
  ],
  "upgrade_policy": {
    "automatic_patch_upgrades": false,
    "requires_new_bundle_id": true,
    "required_steps": [
      "review component changelogs and record API, wire, ticket, hash, and persistent-store changes",
      "pin crate checksums, tags, commits, MSRV, features, licenses, and Cargo.lock",
      "run supply-chain audit and cross-platform reproducible builds",
      "run RPC, two-node transfer, manifest conflict, restart, corruption, cancellation, and redaction tests",
      "test migration using a copy of production-format data and mixed-version peers",
      "publish immutable draft artifacts, attest them, verify digests, and capture --version on every target",
      "canary while retaining the previous binary and pre-migration data snapshot"
    ],
    "rollback": "Atomically restore the retained binary and, if storage migrated, the pre-migration snapshot; never open migrated live data with an older binary unless downgrade safety was proven."
  }
}
