  "sidecar": {
    "binary": "ipfs-kit-iroh-sidecar",
    "version": "0.1.0",
    "owner": "ipfs-kit",
    "distribution_status": "source-pinned",
    "archive_name_template": "ipfs-kit-iroh-sidecar-v{version}-{rust_target}.{archive_format}",
    "version_command": ["ipfs-kit-iroh-sidecar", "--version"],
    "version_stdout": "ipfs-kit-iroh-sidecar 0.1.0 (protocol 1; iroh 1.0.2; iroh-blobs 0.103.0; iroh-docs 0.101.0; iroh-gossip 0.101.0)\n",
    "rpc": {
      "status": "selected",
      "contract": "local versioned RPC owned by ipfs-kit; exact methods are frozen by IROH-002/IROH-006",
      "transport": "local-ipc",
      "capability_groups": [
        "system",
        "blobs",
        "manifests",
        "sync"
      ],
      "required_methods": [
        "system.version",
        "system.capabilities",
        "system.health",
        "system.shutdown",
        "blobs.ingest",
        "blobs.stat",
        "blobs.read_range",
        "blobs.protect",
        "blobs.release",
        "manifests.open",
        "manifests.create",
        "manifests.read",
        "manifests.compare_and_swap",
        "manifests.history",
        "sync.start",
        "sync.progress",
        "sync.cancel",
        "sync.status"
      ]
    },
    "cli": {
      "status": "diagnostic-only",
      "contract": "Only the side-effect-free --version command is selected by this decision; never the per-operation filesystem transport.",
      "commands": [
        {
          "name": "version",
          "argv": ["ipfs-kit-iroh-sidecar", "--version"],
          "stdout_format": "version-line-v1",
          "side_effect_free": true
        }
      ]
    },
    "upstream_binaries": [
      {
        "binary": "iroh-relay",
        "version": "1.0.2",
        "decision": "not-a-backend-runtime",
        "reason": "Relay infrastructure only; it does not expose a local blob or document store API."
      },
      {
        "binary": "iroh-dns-server",
        "version": "1.0.2",
        "decision": "not-a-backend-runtime",
        "reason": "Discovery infrastructure only; it does not expose a local blob or document store API."
      }
    ]
  },
