  "honesty_rules": [
    {
      "id": "rule:capability_unavailable",
      "statement": "Missing platform capability emits a bounded capability_unavailable receipt; it never leaves a task running and never promotes live support."
    },
    {
      "id": "rule:claim_class_separation",
      "statement": "Hermetic, conditional, and live claims are incomparable for production advertisement. Warm/hermetic speedups never satisfy live floors."
    },
    {
      "id": "rule:receipt_freshness",
      "statement": "Support gates reject zero collection, skip-only, stale receipt, continue-on-error, and shell || true softening."
    },
    {
      "id": "rule:no_correctness_relaxation",
      "statement": "Performance cannot be improved by weakening correctness, durability, permissions, or cache coherence."
    },
    {
      "id": "rule:terminal_join_only",
      "statement": "KVFS-811 aggregates immutable evidence from dependency lanes; it does not implement or weaken a gate at release."
    }
  ],
