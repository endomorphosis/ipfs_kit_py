  "chaos_scenarios": {
    "kill": {
      "id": "chaos:kill",
      "description": "Forced process kill mid-mutation; recovery must preserve committed ack and reject stale reads.",
      "safety_counters": [
        "acknowledged_committed_data_loss",
        "kill_recovery_lost_ack",
        "stale_arc_read_after_committed_mutation",
        "leaked_handle_after_test",
        "leaked_mount_after_test",
        "leaked_child_process_after_test",
        "leaked_state_lease_after_test"
      ],
      "required_outcomes": {
        "committed_preserved": true,
        "stale_read_rejected": true,
        "recovery_bounded": true,
        "resources_released": true
      },
      "degradation": {
        "max_recovery_seconds": 60.0,
        "throughput_min_fraction_of_baseline": 0.10
      }
    },
    "torn": {
      "id": "chaos:torn",
      "description": "Torn / partial write never acknowledges durability; valid prefix preserved.",
      "safety_counters": [
        "torn_write_acknowledged",
        "acknowledged_committed_data_loss",
        "false_success_errno_translation"
      ],
      "required_outcomes": {
        "torn_not_acknowledged": true,
        "prefix_preserved": true,
        "fail_closed": true
      },
      "degradation": {
        "max_recovery_seconds": 30.0,
        "throughput_min_fraction_of_baseline": 0.10
      }
    },
    "corrupt": {
      "id": "chaos:corrupt",
      "description": "Corrupt ARC/WAL/cache state is a safe miss or prefix preserve; never admitted as live truth.",
      "safety_counters": [
        "corrupt_state_admitted",
        "stale_arc_read_after_committed_mutation",
        "acknowledged_committed_data_loss"
      ],
      "required_outcomes": {
        "corrupt_safe_miss": true,
        "no_poisoned_hit": true,
        "prefix_or_empty_live_state": true
      },
      "degradation": {
        "max_recovery_seconds": 30.0,
        "throughput_min_fraction_of_baseline": 0.10
      }
    },
    "enospc": {
      "id": "chaos:enospc",
      "description": "ENOSPC / disk pressure fails closed without acknowledging lost data; explicit backpressure under pressure.",
      "safety_counters": [
        "enospc_acknowledged_loss",
        "acknowledged_committed_data_loss",
        "false_success_errno_translation"
      ],
      "required_outcomes": {
        "no_acknowledged_loss": true,
        "explicit_failure": true,
        "fail_closed": true
      },
      "degradation": {
        "max_recovery_seconds": 30.0,
        "throughput_min_fraction_of_baseline": 0.0
      }
    },
    "backpressure": {
      "id": "chaos:backpressure",
      "description": "Queue/memory/descriptor saturation applies explicit backpressure; no unbounded growth.",
      "safety_counters": [
        "backpressure_unbounded_queue",
        "leaked_handle_after_test",
        "unbounded_startup_doctor_mount_unmount"
      ],
      "required_outcomes": {
        "queue_bounded": true,
        "explicit_rejection_or_wait": true,
        "resources_return_within_tolerance": true
      },
      "degradation": {
        "max_queue_depth": 64,
