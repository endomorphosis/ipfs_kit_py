  "comparison_rules": {
    "immutable": true,
    "rule_id": "KernelVFSComparisonRules@1",
    "rules": [
      {
        "id": "identity_bind",
        "statement": "Comparisons require exact match on profile, path_class, workload, seed, concurrency, durability, warmup, samples, and confidence."
      },
      {
        "id": "path_class_separation",
        "statement": "cold and warm path results are incomparable across classes. Warm cache speedups never satisfy cold floors."
      },
      {
        "id": "committed_not_accepted",
        "statement": "Primary transaction/WAL throughput is committed_ops_per_s. accepted metrics may be reported but never satisfy a committed floor."
      },
      {
        "id": "absolute_floor_lock",
        "statement": "After floors are reviewed, absolute per-profile floors cannot be lowered in the same change that fails them."
      },
      {
        "id": "zero_safety_floors",
        "statement": "Safety counters must remain exactly zero under kill, torn write, corrupt state, ENOSPC, and backpressure chaos."
      },
      {
        "id": "bounded_degradation",
        "statement": "Under overload or fault injection, throughput may degrade only within degradation_bounds; resource growth stays within ceilings; recovery remains bounded."
      },
      {
        "id": "no_correctness_relaxation",
        "statement": "No durability, authorization, consistency, coherence, or correctness relaxation may accompany a performance claim."
      },
      {
        "id": "partial_samples_fail",
        "statement": "Benchmark errors or partial sample sets cannot pass a floor gate."
      }
    ],
    "default_tolerances": {
      "throughput_regression_max_fraction": 0.05,
      "p99_regression_max_fraction": 0.10,
      "degradation_throughput_min_fraction": 0.10
    }
  },
